# ===========================================================
# 環境変数の「見本」ファイル
#
# このファイルは中身が空なのでGitに入れてOK（何を書くかのメモとして使う）。
# 実際の値は .env.local というファイルに書きます。
# .env.local は .gitignore で除外済みなので、絶対にGitには入りません。
#
# Phase 1 の時点では、設定が必要なものはありません（地図はキー不要）。
# Phase 2 で Supabase を使うときに、以下を .env.local に書き写して埋めます。
# ===========================================================

# Supabase のプロジェクトURL（Phase 2 で取得）
# NEXT_PUBLIC_ で始まる名前は「ブラウザにも渡っていい情報」という意味です
NEXT_PUBLIC_SUPABASE_URL=

# Supabase の公開用キー（ブラウザから使う。読み取り権限はDB側のルールで制御する）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

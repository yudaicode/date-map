# ===========================================================
# 環境変数の「見本」ファイル
#
# このファイルは値が空なのでGitに入れてOK（何を書くかのメモ）。
# 実際の値は .env.local に書きます。.env.local はGitに入りません。
#
# 値を変えたら、開発サーバーの再起動が必要です
# （Ctrl+C で止めて npm run dev）。
# ===========================================================

# Supabase の Project URL
# 取得場所: Supabase → 左下 Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=

# Supabase の anon public キー（ブラウザに渡ってよい公開鍵）
# 実際に何ができるかは、データベース側の RLS が決めます。
# ※ service_role キーは絶対にここに書かないこと（RLSを無視できる強力な鍵のため）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
